load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "benchreport",
    srcs = [
        "markers.go",
        "metrics.go",
        "render.go",
        "report.go",
        "result.go",
    ],
    importpath = "github.com/iampat/benchmarks/scaling-queue-postgres/internal/benchreport",
    visibility = ["//scaling-queue-postgres:__subpackages__"],
    deps = ["//scaling-queue-postgres/internal/experiment"],
)

go_test(
    name = "benchreport_test",
    srcs = [
        "benchreport_test.go",
        "render_test.go",
    ],
    deps = [
        ":benchreport",
        "//scaling-queue-postgres/internal/experiment",
    ],
)
